#!/bin/bash

RELEASE_DIR="build/Release"

mkdir -p $RELEASE_DIR
cmake -B $RELEASE_DIR -DCMAKE_BUILD_TYPE=Release
cmake --build $RELEASE_DIR -j 6 || { echo -e "\n[Error] Build failed"; exit 1; }

if [ ! -n "$1" ]; then
    echo "Usage: $0 <dataset_name> [model_name] [grid_file]"
    exit 1
fi

# --------------------
# Training parameters

TRIALS=1 # Number of trials to run
EPOCHS=600 # Max number of epochs, actually handled by linear search and early stopping
PATIENCE=0.125 # Fraction of epochs to wait for improvement before early stopping
WARMUP=0.1 # Fraction of epochs to warmup the learning rate
INNER_K=5 # Number of folds for inner cross-validation
OUTER_K=1 # Holdout to use predefined train/test split if available

STOPPING="convergence" # Stopping rule for final retrain: convergence, best, last
NORMALIZATION="minmax" # Normalization method: none, minmax, max, zscore
DATASET_RATIO=1.0 # Fraction of the dataset to use
TRAIN_RATIO=0.8 # Fallback for datasets that don't have a predefined train/test split
SEED=42 # Random seed for reproducibility

# --------------------

NAME="$1"
if [ -n "$2" ]; then
    NAME="$2"
fi

if [ -n "$3" ]; then
    GRID_FILE="grids/$3.csv"
else
    GRID_FILE="grids/$1.csv"
fi

if [ ! -f "$GRID_FILE" ]; then
    echo "[Error] Grid file not found: $GRID_FILE"
    exit 1
fi

LAUNCHER=""
if command -v booster >/dev/null 2>&1; then
    LAUNCHER="booster"
fi

clear
echo "[1] Early Stop"
echo "[2] Live Plot"
echo "[3] Best Model"
echo "[4] Kill Process"

$LAUNCHER ./$RELEASE_DIR/NeuralNet "$1" --name "$NAME" --grid $GRID_FILE \
    --train --shuffle --seed $SEED --trials $TRIALS \
    --dataset_ratio $DATASET_RATIO --train_ratio $TRAIN_RATIO \
    --inner-k $INNER_K --outer-k $OUTER_K \
    --epochs $EPOCHS --patience $PATIENCE --warmup $WARMUP \
    --normalization $NORMALIZATION --stopping $STOPPING &

run_live_plot() {
    python3 ./scripts/live_plot.py "$NAME" >/dev/null 2>&1 &
}

run_best_model() {
    python3 ./scripts/best_model.py "$NAME" >/dev/null 2>&1 &
}

run_live_plot

while true; do
    if read -t 1 -n 1 -s key; then
        PID=$(pgrep "NeuralNet" | head -n 1)
        if [ -z "$PID" ]; then
            break
        fi

        if [[ $key == "1" ]]; then
            kill -SIGUSR1 "$PID"
        elif [[ $key == "2" ]]; then
            run_live_plot
        elif [[ $key == "3" ]]; then
            run_best_model
        elif [[ $key == "4" ]]; then
            kill -SIGINT "$PID"
        fi
    fi
    if ! pgrep "NeuralNet" > /dev/null; then
        break
    fi
done

run_best_model