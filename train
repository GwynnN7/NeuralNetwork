#!/bin/bash

RELEASE_DIR="build/Release"

mkdir -p $RELEASE_DIR
cmake -B $RELEASE_DIR -DCMAKE_BUILD_TYPE=Release
cmake --build $RELEASE_DIR -j 6 || { echo -e "\n[Error] Build failed"; exit 1; }

if [ ! -n "$1" ]; then
    echo "Usage: $0 <dataset_name> [model_name] [grid_file]"
    exit 1
fi

# --------------------
# Training parameters

EPOCHS=800
INNER_K=3
OUTER_K=3

DATASET_RATIO=1.0
TRAIN_RATIO=0.8

# --------------------

NAME="$1"
if [ -n "$2" ]; then
    NAME="$1"_"$2"
fi

GRID_FILE="dataset/$1/grid.csv"
if [ -n "$3" ]; then
    GRID_FILE="dataset/$1/$3.csv"
fi

clear
echo "[1] Kill Process (SIGINT)"
echo "[2] Early Stop   (SIGUSR)"

booster ./$RELEASE_DIR/NeuralNet "$1" --name "$NAME" --train \
    --params $GRID_FILE \
    --dataset_ratio $DATASET_RATIO --train_ratio $TRAIN_RATIO \
    --inner-k $INNER_K --outer-k $OUTER_K --epochs $EPOCHS &

while true; do
    if read -t 1 -n 1 -s key; then
        PID=$(pgrep "NeuralNet" | head -n 1)
        if [ -z "$PID" ]; then
            break
        fi

        if [[ $key == "1" ]]; then
            kill -SIGINT "$PID"
        elif [[ $key == "2" ]]; then
            kill -SIGUSR1 "$PID"
        fi
    fi
    if ! pgrep "NeuralNet" > /dev/null; then
        break
    fi
done