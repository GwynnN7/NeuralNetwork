#!/bin/bash

RELEASE_DIR="build/Release"
LOGS_DIR="logs"

mkdir -p $RELEASE_DIR
mkdir -p $LOGS_DIR
cmake -B $RELEASE_DIR -DCMAKE_BUILD_TYPE=Release #-DNN_DOUBLE_PRECISION=ON -NN_USE_BLAS=OFF
cmake --build $RELEASE_DIR -j 6 || { echo -e "\n[Error] Build failed"; exit 1; }

if [ ! -n "$1" ]; then
    echo "Usage: $0 <dataset_name> [model_name] [grid_file]"
    exit 1
fi

# --------------------
# Default training parameters

TRIALS=5 # Number of trials to run
UPDATES=600 # Number of weight updates per run
WINDOW=20 # Window size for model score calculation
PATIENCE=75 # Weight updates without improvement before early stopping
WARMUP=50 # Weight updates spent increasing the learning rate
INNER_K=5 # Number of folds for inner cross-validation
OUTER_K=1 # Holdout to use predefined train/test split if available

STOPPING="patience" # Stopping rule: none, error, patience
DATASET_RATIO=1.0 # Fraction of the dataset to use
TRAIN_RATIO=0.8 # Fallback for datasets that don't have a predefined train/test split
SEED=42 # Random seed for reproducibility

# Per-dataset overrides
case "$1" in
mlcup)
    TRIALS=3
    INNER_K=5
    OUTER_K=5
    UPDATES=25000
    WINDOW=200
    PATIENCE=1500
    WARMUP=50
    ;;
mnist)
    UPDATES=82000
    WINDOW=200
    PATIENCE=3000
    DATASET_RATIO=0.5
    OUTER_K=3
    ;;
esac

# --------------------

GRID_NAME="${3:-$1}"
GRID_NAME="${GRID_NAME%.csv}"
NAME="${2:-$(basename "$GRID_NAME")}"
DIR_NAME="${1%_*}"
DIR_NAME="${DIR_NAME%%[0-9]*}"

if [ -d "grids/$DIR_NAME" ]; then
    GRID_FILE="grids/$DIR_NAME/${GRID_NAME}.csv"
else
    GRID_FILE="grids/${GRID_NAME}.csv"
fi

if [ ! -f "$GRID_FILE" ]; then
    echo "[Error] Grid file not found: $GRID_FILE"
    exit 1
fi

LAUNCHER=""
if command -v booster >/dev/null 2>&1; then
    LAUNCHER="booster"
fi

clear
echo "[1] Early Stop"
echo "[2] Live Plot"
echo "[3] Best Model"
echo "[4] Finish Now"
echo "[5] Kill Process"

$LAUNCHER ./$RELEASE_DIR/NeuralNet "$1" --name "$NAME" --grid $GRID_FILE \
    --train --shuffle --seed $SEED --trials $TRIALS \
    --dataset_ratio $DATASET_RATIO --train_ratio $TRAIN_RATIO \
    --inner-k $INNER_K --outer-k $OUTER_K \
    --updates $UPDATES --patience $PATIENCE --warmup $WARMUP \
    --stopping $STOPPING --window $WINDOW > $LOGS_DIR/"$NAME".log &

run_live_plot() {
    python3 ./scripts/live_plot.py "$NAME" >/dev/null 2>&1 &
}

run_best_model() {
    python3 ./scripts/best_model.py "$NAME" >/dev/null 2>&1 &
}

run_live_plot

while true; do
    if read -t 1 -n 1 -s key; then
        PID=$(pgrep "NeuralNet" | head -n 1)
        if [ -z "$PID" ]; then
            break
        fi

        if [[ $key == "1" ]]; then
            kill -SIGUSR1 "$PID"
        elif [[ $key == "2" ]]; then
            run_live_plot
        elif [[ $key == "3" ]]; then
            run_best_model
        elif [[ $key == "4" ]]; then
            kill -SIGUSR2 "$PID"
        elif [[ $key == "5" ]]; then
            kill -SIGINT "$PID"
        fi
    fi
    if ! pgrep "NeuralNet" > /dev/null; then
        break
    fi
done

run_best_model
